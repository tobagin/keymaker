#: data/io.github.tobagin.keysmith.desktop.in:2
#: data/io.github.tobagin.keysmith.metainfo.xml.in:7
msgid "@APP_NAME@"
msgstr "@APP_NAME@"

#: data/io.github.tobagin.keysmith.desktop.in:3
msgid "SSH Key Management Application"
msgstr "Aplicación de gestión de claves SSH"

#: data/io.github.tobagin.keysmith.desktop.in:9
msgid "ssh;keys;security;remote;authentication;"
msgstr "ssh;keys;claves;security;seguridad;remote;remoto;authentication;autenticación;"

#: data/io.github.tobagin.keysmith.gschema.xml.in:7
msgid "Default window width"
msgstr "Anchura predeterminada de la ventana"

#: data/io.github.tobagin.keysmith.gschema.xml.in:8
msgid "The default width of the main window"
msgstr "La anchura predeterminada de la ventana principal"

#: data/io.github.tobagin.keysmith.gschema.xml.in:13
msgid "Default window height"
msgstr "Altura predeterminada de la ventana"

#: data/io.github.tobagin.keysmith.gschema.xml.in:14
msgid "The default height of the main window"
msgstr "La altura predeterminada de la ventana principal"

#: data/io.github.tobagin.keysmith.gschema.xml.in:19
msgid "Window maximized state"
msgstr "Estado maximizado de la ventana"

#: data/io.github.tobagin.keysmith.gschema.xml.in:20
msgid "Whether the window is maximized"
msgstr "Indica si la ventana está maximizada"

#: data/io.github.tobagin.keysmith.gschema.xml.in:25
msgid "Default SSH key type"
msgstr "Tipo de clave SSH predeterminado"

#: data/io.github.tobagin.keysmith.gschema.xml.in:26
msgid "The default SSH key type to use when generating new keys"
msgstr "El tipo de clave SSH predeterminado al generar claves nuevas"

#: data/io.github.tobagin.keysmith.gschema.xml.in:31
msgid "Default RSA key size"
msgstr "Tamaño predeterminado de las claves RSA"

#: data/io.github.tobagin.keysmith.gschema.xml.in:32
msgid "The default bit size for RSA keys"
msgstr "El tamaño en bits predeterminado para las claves RSA"

#: data/io.github.tobagin.keysmith.gschema.xml.in:37
msgid "Default ECDSA curve"
msgstr "Curva ECDSA predeterminada"

#: data/io.github.tobagin.keysmith.gschema.xml.in:38
msgid "The default curve size for ECDSA keys (256, 384, or 521)"
msgstr "El tamaño de curva predeterminado para las claves ECDSA (256, 384 o 521)"

#: data/io.github.tobagin.keysmith.gschema.xml.in:43
msgid "Default key comment"
msgstr "Comentario predeterminado de la clave"

#: data/io.github.tobagin.keysmith.gschema.xml.in:44
msgid "The default comment to use for new SSH keys"
msgstr "El comentario predeterminado para las claves SSH nuevas"

#: data/io.github.tobagin.keysmith.gschema.xml.in:49
msgid "Use passphrase by default"
msgstr "Usar frase de contraseña de forma predeterminada"

#: data/io.github.tobagin.keysmith.gschema.xml.in:50
msgid "Whether to enable passphrase protection by default for new keys"
msgstr ""
"Indica si la protección con frase de contraseña se activa de forma "
"predeterminada para las claves nuevas"

#: data/io.github.tobagin.keysmith.gschema.xml.in:55
msgid "Auto refresh interval"
msgstr "Intervalo de actualización automática"

#: data/io.github.tobagin.keysmith.gschema.xml.in:56
msgid ""
"Interval in seconds for automatically refreshing the key list (0 to disable)"
msgstr ""
"Intervalo en segundos para actualizar automáticamente la lista de claves (0 "
"para desactivar)"

#: data/io.github.tobagin.keysmith.gschema.xml.in:61
msgid "Show fingerprints"
msgstr "Mostrar huellas digitales"

#: data/io.github.tobagin.keysmith.gschema.xml.in:62
msgid "Whether to show key fingerprints in the key list"
msgstr ""
"Indica si se muestran las huellas digitales de las claves en la lista de "
"claves"

#: data/io.github.tobagin.keysmith.gschema.xml.in:67
msgid "Confirm key deletions"
msgstr "Confirmar la eliminación de claves"

#: data/io.github.tobagin.keysmith.gschema.xml.in:68
msgid "Whether to show confirmation dialog before deleting keys"
msgstr ""
"Indica si se muestra un diálogo de confirmación antes de eliminar claves"

#: data/io.github.tobagin.keysmith.gschema.xml.in:73
msgid "Theme preference"
msgstr "Preferencia de tema"

#: data/io.github.tobagin.keysmith.gschema.xml.in:74
msgid "The theme to use: 'auto' (system), 'light', or 'dark'"
msgstr "El tema que usar: «auto» (sistema), «claro» u «oscuro»"

#: data/io.github.tobagin.keysmith.gschema.xml.in:79
msgid "Last version for which release notes were shown"
msgstr "Última versión cuyas notas de publicación se mostraron"

#: data/io.github.tobagin.keysmith.gschema.xml.in:80
msgid ""
"Tracks the last application version for which release notes were displayed "
"to avoid showing them repeatedly"
msgstr ""
"Registra la última versión de la aplicación cuyas notas de publicación se "
"mostraron, para evitar mostrarlas repetidamente"

#: data/io.github.tobagin.keysmith.gschema.xml.in:85
msgid "SSH key service mappings"
msgstr "Asociaciones de servicios de claves SSH"

#: data/io.github.tobagin.keysmith.gschema.xml.in:86
msgid "Stores associations between SSH keys and services they are used for"
msgstr ""
"Almacena las asociaciones entre las claves SSH y los servicios en los que se "
"usan"

#: data/io.github.tobagin.keysmith.gschema.xml.in:91
msgid "SSH key rotation plans"
msgstr "Planes de rotación de claves SSH"

#: data/io.github.tobagin.keysmith.gschema.xml.in:92
msgid ""
"Stores rotation plan configurations for SSH keys including targets and "
"settings"
msgstr ""
"Almacena las configuraciones de los planes de rotación de claves SSH, "
"incluidos los destinos y los ajustes"

#: data/io.github.tobagin.keysmith.gschema.xml.in:97
#: data/io.github.tobagin.keysmith.gschema.xml.in:249
msgid "SSH tunnel configurations"
msgstr "Configuraciones de túneles SSH"

#: data/io.github.tobagin.keysmith.gschema.xml.in:98
#: data/io.github.tobagin.keysmith.gschema.xml.in:250
msgid "Stores saved SSH tunnel configurations"
msgstr "Almacena las configuraciones de túneles SSH guardadas"

#: data/io.github.tobagin.keysmith.gschema.xml.in:103
msgid "Preferred terminal emulator"
msgstr "Emulador de terminal preferido"

#: data/io.github.tobagin.keysmith.gschema.xml.in:104
msgid ""
"The preferred terminal emulator to use for SSH connections: 'auto' (detect "
"automatically) or specific terminal name"
msgstr ""
"El emulador de terminal preferido para las conexiones SSH: «auto» (detectar "
"automáticamente) o el nombre de un terminal concreto"

#: data/io.github.tobagin.keysmith.gschema.xml.in:109
msgid "Auto-run diagnostics"
msgstr "Ejecutar diagnósticos automáticamente"

#: data/io.github.tobagin.keysmith.gschema.xml.in:110
msgid "Whether to automatically run diagnostic tests when they are added"
msgstr ""
"Indica si las pruebas de diagnóstico se ejecutan automáticamente al añadirlas"

#: data/io.github.tobagin.keysmith.gschema.xml.in:115
msgid "Diagnostics retention period"
msgstr "Periodo de conservación de los diagnósticos"

#: data/io.github.tobagin.keysmith.gschema.xml.in:116
msgid ""
"Number of days to keep diagnostic history entries before automatic cleanup"
msgstr ""
"Número de días que se conservan las entradas del historial de diagnósticos "
"antes de la limpieza automática"

#: data/io.github.tobagin.keysmith.gschema.xml.in:121
msgid "GitHub connection status"
msgstr "Estado de la conexión con GitHub"

#: data/io.github.tobagin.keysmith.gschema.xml.in:122
msgid "Whether a GitHub account is currently connected"
msgstr "Indica si hay una cuenta de GitHub conectada actualmente"

#: data/io.github.tobagin.keysmith.gschema.xml.in:127
msgid "GitHub username"
msgstr "Nombre de usuario de GitHub"

#: data/io.github.tobagin.keysmith.gschema.xml.in:128
msgid "The connected GitHub username"
msgstr "El nombre de usuario de GitHub conectado"

#: data/io.github.tobagin.keysmith.gschema.xml.in:133
msgid "GitLab connection status"
msgstr "Estado de la conexión con GitLab"

#: data/io.github.tobagin.keysmith.gschema.xml.in:134
msgid "Whether a GitLab account is currently connected"
msgstr "Indica si hay una cuenta de GitLab conectada actualmente"

#: data/io.github.tobagin.keysmith.gschema.xml.in:139
msgid "GitLab username"
msgstr "Nombre de usuario de GitLab"

#: data/io.github.tobagin.keysmith.gschema.xml.in:140
msgid "The connected GitLab username"
msgstr "El nombre de usuario de GitLab conectado"

#: data/io.github.tobagin.keysmith.gschema.xml.in:145
msgid "GitLab instance URL"
msgstr "URL de la instancia de GitLab"

#: data/io.github.tobagin.keysmith.gschema.xml.in:146
msgid "The URL of the GitLab instance (GitLab.com or self-hosted)"
msgstr "La URL de la instancia de GitLab (GitLab.com o autoalojada)"

#: data/io.github.tobagin.keysmith.gschema.xml.in:151
msgid "Allow self-signed certificates"
msgstr "Permitir certificados autofirmados"

#: data/io.github.tobagin.keysmith.gschema.xml.in:152
msgid ""
"Whether to allow self-signed certificates for self-hosted GitLab instances "
"(insecure)"
msgstr ""
"Indica si se permiten certificados autofirmados para las instancias "
"autoalojadas de GitLab (inseguro)"

#: data/io.github.tobagin.keysmith.gschema.xml.in:157
msgid "GitLab OAuth Client ID"
msgstr "ID de cliente OAuth de GitLab"

#: data/io.github.tobagin.keysmith.gschema.xml.in:158
msgid "The OAuth application client ID for GitLab"
msgstr "El ID de cliente OAuth de la aplicación para GitLab"

#: data/io.github.tobagin.keysmith.gschema.xml.in:163
msgid "GitLab OAuth Client Secret"
msgstr "Secreto de cliente OAuth de GitLab"

#: data/io.github.tobagin.keysmith.gschema.xml.in:164
msgid "The OAuth application client secret for GitLab"
msgstr "El secreto de cliente OAuth de la aplicación para GitLab"

#: data/io.github.tobagin.keysmith.gschema.xml.in:169
msgid "Bitbucket connection status"
msgstr "Estado de la conexión con Bitbucket"

#: data/io.github.tobagin.keysmith.gschema.xml.in:170
msgid "Whether a Bitbucket account is currently connected"
msgstr "Indica si hay una cuenta de Bitbucket conectada actualmente"

#: data/io.github.tobagin.keysmith.gschema.xml.in:175
msgid "Bitbucket username"
msgstr "Nombre de usuario de Bitbucket"

#: data/io.github.tobagin.keysmith.gschema.xml.in:176
msgid "The connected Bitbucket username"
msgstr "El nombre de usuario de Bitbucket conectado"

#: data/io.github.tobagin.keysmith.gschema.xml.in:181
msgid "Gitea OAuth Client ID"
msgstr "ID de cliente OAuth de Gitea"

#: data/io.github.tobagin.keysmith.gschema.xml.in:182
msgid "The OAuth application client ID for Gitea"
msgstr "El ID de cliente OAuth de la aplicación para Gitea"

#: data/io.github.tobagin.keysmith.gschema.xml.in:187
msgid "Gitea OAuth Client Secret"
msgstr "Secreto de cliente OAuth de Gitea"

#: data/io.github.tobagin.keysmith.gschema.xml.in:188
msgid "The OAuth application client secret for Gitea"
msgstr "El secreto de cliente OAuth de la aplicación para Gitea"

#: data/io.github.tobagin.keysmith.gschema.xml.in:193
msgid "GCP OAuth Client ID"
msgstr "ID de cliente OAuth de GCP"

#: data/io.github.tobagin.keysmith.gschema.xml.in:194
msgid "The OAuth application client ID for Google Cloud Platform"
msgstr "El ID de cliente OAuth de la aplicación para Google Cloud Platform"

#: data/io.github.tobagin.keysmith.gschema.xml.in:199
msgid "GCP OAuth Client Secret"
msgstr "Secreto de cliente OAuth de GCP"

#: data/io.github.tobagin.keysmith.gschema.xml.in:200
msgid "The OAuth application client secret for Google Cloud Platform"
msgstr "El secreto de cliente OAuth de la aplicación para Google Cloud Platform"

#: data/io.github.tobagin.keysmith.gschema.xml.in:205
msgid "AWS IAM connection status"
msgstr "Estado de la conexión con AWS IAM"

#: data/io.github.tobagin.keysmith.gschema.xml.in:206
msgid "Whether an AWS IAM account is currently connected"
msgstr "Indica si hay una cuenta de AWS IAM conectada actualmente"

#: data/io.github.tobagin.keysmith.gschema.xml.in:211
msgid "AWS IAM username"
msgstr "Nombre de usuario de AWS IAM"

#: data/io.github.tobagin.keysmith.gschema.xml.in:212
msgid "The connected AWS IAM username"
msgstr "El nombre de usuario de AWS IAM conectado"

#: data/io.github.tobagin.keysmith.gschema.xml.in:217
msgid "AWS region"
msgstr "Región de AWS"

#: data/io.github.tobagin.keysmith.gschema.xml.in:218
msgid "The AWS region to use for API requests"
msgstr "La región de AWS que usar para las peticiones de la API"

#: data/io.github.tobagin.keysmith.gschema.xml.in:223
msgid "AWS Access Key ID (for lookup)"
msgstr "ID de clave de acceso de AWS (para la búsqueda)"

#: data/io.github.tobagin.keysmith.gschema.xml.in:224
msgid "The AWS Access Key ID for retrieving the secret from Secret Service"
msgstr ""
"El ID de clave de acceso de AWS para obtener el secreto del Servicio de "
"secretos"

#: data/io.github.tobagin.keysmith.gschema.xml.in:229
msgid "Cloud provider key cache"
msgstr "Caché de claves del proveedor en la nube"

#: data/io.github.tobagin.keysmith.gschema.xml.in:230
msgid "JSON cache of cloud provider SSH keys for offline viewing"
msgstr ""
"Caché JSON de las claves SSH de los proveedores en la nube para consultarlas "
"sin conexión"

#: data/io.github.tobagin.keysmith.gschema.xml.in:235
msgid "Show deployment warning"
msgstr "Mostrar advertencia de despliegue"

#: data/io.github.tobagin.keysmith.gschema.xml.in:236
msgid "Whether to show security warning before deploying keys to cloud"
msgstr ""
"Indica si se muestra una advertencia de seguridad antes de desplegar claves "
"en la nube"

#: data/io.github.tobagin.keysmith.gschema.xml.in:241
msgid "Cloud provider accounts"
msgstr "Cuentas de proveedores en la nube"

#: data/io.github.tobagin.keysmith.gschema.xml.in:242
msgid ""
"JSON array of configured cloud provider accounts (GitHub, GitLab, Bitbucket)"
msgstr ""
"Lista JSON de las cuentas configuradas de proveedores en la nube (GitHub, "
"GitLab, Bitbucket)"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:8
msgid "Manage SSH keys easily"
msgstr "Gestione sus claves SSH fácilmente"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:11
msgid ""
"Keymaker allows you to manage your SSH keys without dealing with the command "
"line. It helps you generate new keys, view existing ones, and deploy them to "
"servers with a simple interface."
msgstr ""
"Keymaker le permite gestionar sus claves SSH sin recurrir a la línea de "
"órdenes. Le ayuda a generar claves nuevas, ver las existentes y desplegarlas "
"en servidores mediante una interfaz sencilla."

#: data/io.github.tobagin.keysmith.metainfo.xml.in:15
msgid "Features:"
msgstr "Funcionalidades:"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:19
msgid "Generate new SSH keys (Ed25519, RSA, ECDSA)"
msgstr "Generar claves SSH nuevas (Ed25519, RSA, ECDSA)"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:20
msgid "View and manage keys in your local directory"
msgstr "Ver y gestionar las claves de su directorio local"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:21
msgid "Copy public keys to your clipboard"
msgstr "Copiar claves públicas al portapapeles"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:22
msgid "Deploy keys to remote servers"
msgstr "Desplegar claves en servidores remotos"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:23
msgid "Update key passphrases"
msgstr "Cambiar las frases de contraseña de las claves"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:24
msgid "Delete unused keys securely"
msgstr "Eliminar de forma segura las claves sin usar"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:25
msgid "Modern interface built for GNOME"
msgstr "Interfaz moderna diseñada para GNOME"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:37
msgid "Main window showing SSH key management"
msgstr "Ventana principal con la gestión de claves SSH"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:41
msgid "Key generation wizard"
msgstr "Asistente de generación de claves"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:45
msgid "Detailed SSH key information"
msgstr "Información detallada de las claves SSH"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:49
msgid "Deploy keys to servers easily"
msgstr "Despliegue claves en servidores fácilmente"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:53
msgid "Application preferences"
msgstr "Preferencias de la aplicación"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:57
msgid "Secure backup and restore"
msgstr "Copia de seguridad y restauración seguras"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:61
msgid "Manage SSH config hosts"
msgstr "Gestionar los equipos de la configuración de SSH"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:65
msgid "Manage known hosts"
msgstr "Gestionar los equipos conocidos"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:69
msgid "About Keymaker"
msgstr "Acerca de Keymaker"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:78
msgid "Thiago Fernandes"
msgstr "Thiago Fernandes"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:97
msgid "ssh"
msgstr "ssh"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:98
msgid "keys"
msgstr "claves"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:99
msgid "security"
msgstr "seguridad"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:100
msgid "remote"
msgstr "remoto"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:101
msgid "authentication"
msgstr "autenticación"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:109
msgid ""
"Keymaker 1.4.0 adds Warp terminal support and three new per-host SSH config "
"options."
msgstr ""
"Keymaker 1.4.0 añade compatibilidad con el terminal Warp y tres opciones "
"nuevas de configuración de SSH por equipo."

#: data/io.github.tobagin.keysmith.metainfo.xml.in:111
msgid "Add Warp to the preferred terminal emulator list"
msgstr "Se ha añadido Warp a la lista de emuladores de terminal preferidos"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:112
msgid ""
"Add WarnWeakCrypto, IdentitiesOnly, and IdentityAgent options to the SSH "
"host editor"
msgstr ""
"Se han añadido las opciones WarnWeakCrypto, IdentitiesOnly e IdentityAgent "
"al editor de equipos SSH"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:118
msgid ""
"Keymaker 1.3.0 adds support for ED25519-SK security keys and features "
"several UI refinements."
msgstr ""
"Keymaker 1.3.0 añade compatibilidad con las claves de seguridad ED25519-SK e "
"incluye varias mejoras en la interfaz."

#: data/io.github.tobagin.keysmith.metainfo.xml.in:120
msgid "Added support for ED25519-SK security keys"
msgstr "Se ha añadido compatibilidad con las claves de seguridad ED25519-SK"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:121
msgid "Enhanced key type and bit size detection for security-backed keys"
msgstr ""
"Detección mejorada del tipo de clave y del tamaño en bits para las claves "
"respaldadas por hardware"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:122
msgid ""
"Improved dialog dimensions and removed raised bar styles for a cleaner look"
msgstr ""
"Dimensiones de los diálogos mejoradas y estilos de barra elevada eliminados "
"para un aspecto más limpio"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:123
msgid "Further refinements to dialog layouts for better responsiveness"
msgstr ""
"Más ajustes en la disposición de los diálogos para mejorar su adaptabilidad"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:129
msgid ""
"Keymaker 1.2.0 brings a fully adaptive mobile UI and improved navigation "
"architecture."
msgstr ""
"Keymaker 1.2.0 incorpora una interfaz móvil totalmente adaptable y una "
"arquitectura de navegación mejorada."

#: data/io.github.tobagin.keysmith.metainfo.xml.in:131
msgid "Comprehensive mobile layout adaptation for smaller screens"
msgstr "Adaptación completa de la disposición móvil a pantallas más pequeñas"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:132
msgid "New navigation architecture using Adw.NavigationView"
msgstr "Nueva arquitectura de navegación basada en Adw.NavigationView"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:133
msgid "Redesigned Backup page with bottom sheet integration"
msgstr ""
"Página de copias de seguridad rediseñada con integración de panel inferior"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:134
msgid "Refined Hosts and Known Hosts pages"
msgstr "Páginas «Equipos» y «Equipos conocidos» mejoradas"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:140
msgid "Documentation and metadata improvements:"
msgstr "Mejoras en la documentación y los metadatos:"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:142
msgid "Updated metadata summary and description for better clarity"
msgstr ""
"Se han actualizado el resumen y la descripción de los metadatos para mayor "
"claridad"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:143
msgid "Added new branding colors"
msgstr "Se han añadido colores de marca nuevos"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:144
msgid "Refined documentation and added Flathub/Ko-fi badges"
msgstr ""
"Documentación mejorada y se han añadido las insignias de Flathub y Ko-fi"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:150
msgid "Major update and renaming:"
msgstr "Actualización importante y cambio de nombre:"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:152
msgid "Renamed application from \"KeySmith\" to \"Keymaker\""
msgstr "La aplicación ha pasado de llamarse «KeySmith» a «Keymaker»"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:153
msgid "Complete rewrite in Vala for better performance"
msgstr "Reescritura completa en Vala para mejorar el rendimiento"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:154
msgid ""
"Advanced SSH: Key-Service Mapping, Config Editor, and Recursive Key Scanning"
msgstr ""
"SSH avanzado: asociación de claves y servicios, editor de configuración y "
"búsqueda recursiva de claves"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:155
msgid "Security: QR Code Backups and Time-locked recovery"
msgstr ""
"Seguridad: copias de seguridad en código QR y recuperación con bloqueo "
"temporal"

#: data/io.github.tobagin.keysmith.metainfo.xml.in:156
msgid "New Icons: Fresh new application icons (Thanks to Rosabel)"
msgstr ""
